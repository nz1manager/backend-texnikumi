# =========================================================================
# 1-SON TEXNIKUM BACKEND XAVFSIZLIK VA KONFIGURATSIYA SOZLAMALARI (.env)
# =========================================================================

# 1. Server va Tarmoq Sozlamalari
PORT=10000
APP_ENV=production
ALLOWED_ORIGINS=https://1-sontexnikum.uz,https://www.1-sontexnikum.uz,http://localhost:5173,http://localhost:3000

# 2. Binar Shifrlash va Kriptografik Xavfsizlik Kalitlari (AES-256-GCM)
# 0 va 1 binar darajasida tasvirlarni shifrlash uchun kamida 32 ta belgidan iborat kalit:
ENCRYPTION_KEY=texnikum_ultra_secure_aes256_gcm_secret_key_32bytes_long
API_SECRET_KEY=texnikum_super_secret_internal_auth_signature_key
RATE_LIMIT_PER_MIN=120

# 3. UzCloud S3 Saqlash Xizmati Sozlamalari
S3_ENDPOINT=https://s3.uzcloud.uz
S3_ACCESS_KEY=sizning_access_keyingiz
S3_SECRET_KEY=sizning_secret_keyingiz
S3_BUCKET_NAME=sizning_bucket_nomingiz
S3_REGION=us-east-1

# =========================================================================
# 4. MA'LUMOTLAR BAZASI (DATABASE) ULANISH VA XAVFSIZLIK SOZLAMALARI
# DIQQAT: Hozirda DB_ENABLED=false holatida xavfsiz to'xtatilgan (Coming soon).
# Database ulanishi kerak bo'lganda ushbu qatorlarni to'ldirib, DB_ENABLED=true qilasiz:
# =========================================================================
DB_ENABLED=false
DB_HOST=database.server.uz
DB_PORT=5432
DB_USER=texnikum_secure_admin
DB_PASSWORD=bu_yerga_kuchli_va_shifrlangan_maxfiy_parol_yoziladi
DB_NAME=texnikum_main_db
DB_SSLMODE=require
